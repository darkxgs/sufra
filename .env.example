# Postgres. Without it, Sufra runs on an embedded Postgres (PGlite) in .data/.
# On Neon, use the pooled URL here and the direct one below for migrations.
# Sufra keeps its tables in their own "sufra" schema, so it can share a database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs staff sessions. Optional: without it, Sufra makes a random key the
# first time it needs one and keeps it in the database (sufra.app_keys).
AUTH_SECRET=

# Vercel Cron calls /api/cron/cleanup daily and sends this as a bearer token.
# Optional: without it, anyone may call the route, and it cleans up at most
# once an hour, as opening the staff screens already does.
CRON_SECRET=

# The address printed in table QR codes. Defaults to the address the staff
# page was opened on (useful on a restaurant's Wi-Fi).
SUFRA_PUBLIC_URL=

# Key for hashing visitor addresses in rate limits. Optional, like AUTH_SECRET.
RATE_SALT=
